# ---------------------------------------------------------------------------
# TalentVault environment configuration. Copy to .env.local for development.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put
# secrets in them.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API). Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS — used for CV intake, the job worker and admin user management.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed site (used in emails and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI CV analysis provider: "anthropic" (real AI) or "local" (clearly-labelled
# heuristic development adapter — NOT AI analysis).
AI_PROVIDER=local
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Transactional email: "resend" or "console" (logs emails instead of sending)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="TalentVault <no-reply@yourdomain.com>"
# Comma-separated fallback recipients for admin alerts (in addition to in-app notifications)
ADMIN_NOTIFICATION_EMAILS=

# Shared secret for the cron endpoint (Vercel sends it as a Bearer token)
CRON_SECRET=
# Random string used to hash IP addresses in consent/rate-limit records
IP_HASH_SALT=
